# Unraid deploy only (scripts/deploy.sh -> docker run --env-file). Copy to .env, fill in.
# docker env-file format: KEY=VALUE, no quotes, no spaces around '='.
LOCAL_HOST=192.168.1.10
LOCAL_PORT=1883
LOCAL_USERNAME=mqtt-user
LOCAL_PASSWORD=change-me
# optional: used only until the first frame reports meter_id
METER_ID_DEFAULT=
